  }

  // ---- Radial gauge ----
  function renderGaugeRow(containerId, data, opts = {}) {
    const size = opts.size || 108;
    const stroke = 9;
    const r = (size - stroke) / 2;
    const cx = size / 2, cy = size / 2;
    const circumference = 2 * Math.PI * r;
    document.getElementById(containerId).innerHTML = data.map(d => {
      const pct = Math.max(0, Math.min(1, d.value / 100));
      const dash = (circumference * pct).toFixed(2);
      const gap = (circumference - circumference * pct).toFixed(2);
      return `
        <div class="gauge-item">
          <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
            <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--gridline)" stroke-width="${stroke}" />
            <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${d.color}" stroke-width="${stroke}"
              stroke-dasharray="${dash} ${gap}" stroke-linecap="round" transform="rotate(-90 ${cx} ${cy})">
              <title>${d.label}: ${d.valueLabel}</title>
            </circle>
            <text x="${cx}" y="${cy + 5}" text-anchor="middle" font-size="17" font-weight="800" fill="var(--text-primary)">${d.value}%</text>
          </svg>
          <div class="gauge-label">${d.label}</div>
          <div class="gauge-sub">${d.valueLabel}</div>
        </div>`;
    }).join('');
  }

  // ---- Line chart ----
  function renderLineChart(containerId, data, opts = {}) {
    const w = opts.width || 340, h = opts.height || 170;
    const padL = 30, padR = 30, padT = 18, padB = 26;
    const plotW = w - padL - padR, plotH = h - padT - padB;
    const max = opts.max ?? Math.max(...data.map(d => d.value));
    const min = opts.min ?? 0;
    const range = (max - min) || 1;
    const stepX = data.length > 1 ? plotW / (data.length - 1) : 0;
    const color = opts.color || 'var(--series-1)';
    const points = data.map((d, i) => ({
      x: padL + i * stepX,
      y: padT + plotH - ((d.value - min) / range) * plotH,
      d,
    }));
    const linePath = points.map((p, i) => (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ',' + p.y.toFixed(1)).join(' ');
    const gridLines = [0, 0.5, 1].map(f => {
      const y = padT + plotH * f;
      return `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${w - padR}" y2="${y.toFixed(1)}" stroke="var(--gridline)" stroke-width="1" />`;
    }).join('');
    const dots = points.map(p => `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="5" fill="${color}" stroke="var(--surface-1)" stroke-width="1.5"><title>${p.d.label}: ${p.d.valueLabel}</title></circle>`).join('');
    // Stagger label offset on alternating points when there are enough points that
    // adjacent labels risk touching (e.g. an 8-month trend) — keeps every value legible
    // without needing to drop any. Clamped so it never pushes past the viewBox top.
    const staggerLabels = data.length >= 6;
    const valueLabels = points.map((p, i) => {
      const offset = staggerLabels && i % 2 === 1 ? 22 : 12;
      const y = Math.max(10, p.y - offset);
      return `<text x="${p.x.toFixed(1)}" y="${y.toFixed(1)}" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--text-primary)">${p.d.valueLabel}</text>`;
    }).join('');
    const xLabels = points.map(p => `<text x="${p.x.toFixed(1)}" y="${h - 8}" text-anchor="middle" font-size="11" fill="var(--text-secondary)">${p.d.label}</text>`).join('');
    document.getElementById(containerId).innerHTML = `
      <svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid meet">
        ${gridLines}
        <path d="${linePath}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        ${dots}
        ${valueLabels}
        ${xLabels}
      </svg>`;
  }

