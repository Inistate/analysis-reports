  // ---- Donut chart ----
  function polarToCartesian(cx, cy, r, angleDeg) {
    const rad = angleDeg * Math.PI / 180;
    return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
  }
  function renderDonutChart(chartId, legendId, data, opts = {}) {
    const size = opts.size || 200;
    const r = size / 2 - 6;
    const innerR = r * 0.58;
    const cx = size / 2, cy = size / 2;
    const total = data.reduce((s, d) => s + d.value, 0);
    let angle = -90;
    const paths = data.map(d => {
      const frac = d.value / total;
      const start = angle;
      const end = angle + frac * 360;
      angle = end;
      const large = (end - start) > 180 ? 1 : 0;
      const so = polarToCartesian(cx, cy, r, start);
      const eo = polarToCartesian(cx, cy, r, end);
      const si = polarToCartesian(cx, cy, innerR, end);
      const ei = polarToCartesian(cx, cy, innerR, start);
      const path = `M ${so.x.toFixed(2)} ${so.y.toFixed(2)} A ${r} ${r} 0 ${large} 1 ${eo.x.toFixed(2)} ${eo.y.toFixed(2)} L ${si.x.toFixed(2)} ${si.y.toFixed(2)} A ${innerR} ${innerR} 0 ${large} 0 ${ei.x.toFixed(2)} ${ei.y.toFixed(2)} Z`;
      return `<path d="${path}" fill="${d.color}" stroke="var(--surface-1)" stroke-width="2"><title>${d.label}: ${d.valueLabel}</title></path>`;
    }).join('');
    document.getElementById(chartId).innerHTML = `
      <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
        ${paths}
        <text x="${cx}" y="${cy - 4}" text-anchor="middle" font-size="24" font-weight="800" fill="var(--text-primary)">${total}</text>
        <text x="${cx}" y="${cy + 16}" text-anchor="middle" font-size="10.5" fill="var(--text-secondary)" style="text-transform:uppercase;letter-spacing:.05em;">entries</text>
      </svg>`;
    document.getElementById(legendId).innerHTML = data.map(d => `
      <div class="dl-row">
        <span class="dl-swatch" style="background:${d.color}"></span>
        <span class="dl-name">${d.label}</span>
        <span class="dl-val">${d.valueLabel}</span>
      </div>`).join('');
  }

  // ---- Tornado (diverging) chart ----
  function renderTornadoChart(containerId, data, opts = {}) {
    const el = document.getElementById(containerId);
    const max = opts.max || Math.max(...data.flatMap(d => [d.left.value, d.right.value])) || 1;
    el.innerHTML = data.map(d => {
      const lPct = (d.left.value / max * 100).toFixed(1);
      const rPct = (d.right.value / max * 100).toFixed(1);
      return `
        <div class="tornado-row">
          <div class="tornado-left">
            <span class="tornado-val">${d.left.value}</span>
            <div class="tornado-bar" style="width:${lPct}%; background:${d.left.color}" title="${d.label} — reassigned away before reviewing: ${d.left.value}"></div>
          </div>
          <div class="tornado-mid">${d.label}</div>
          <div class="tornado-right">
            <div class="tornado-bar" style="width:${rPct}%; background:${d.right.color}" title="${d.label} — completed after reassignment: ${d.right.value}"></div>
            <span class="tornado-val">${d.right.value}</span>
