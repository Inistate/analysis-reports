  function renderBarChart(containerId, data, opts = {}) {
    const el = document.getElementById(containerId);
    const max = opts.max || Math.max(...data.map(d => d.value)) || 1;
    const colorFor = (d) => d.color || opts.singleColor || 'var(--series-1)';
    el.innerHTML = data.map(d => {
      const widthPct = (d.value / max * 100).toFixed(1);
      const color = colorFor(d);
      const valueLabel = d.valueLabel || `${d.value} · ${d.pct}`;
      const track = opts.lollipop
        ? `<div class="bar-track"><div class="lollipop-line" style="width:${widthPct}%; --bar-color:${color}"></div><div class="lollipop-dot" style="left:${widthPct}%; --bar-color:${color}" title="${d.label}: ${valueLabel}"></div></div>`
        : `<div class="bar-track"><div class="bar-fill" style="width:${widthPct}%; --bar-color:${color}" title="${d.label}: ${valueLabel}"></div></div>`;
      return `
        <div class="bar-row">
          <div class="bar-label">${d.label}</div>
          ${track}
          <div class="bar-value">${valueLabel}</div>
        </div>`;
    }).join('');
